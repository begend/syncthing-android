<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webdavHomeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/list_divider_inset"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/webdavHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/category_webdav_sync"
        android:textAppearance="?textAppearanceListItemPrimary" />

    <TextView
        android:id="@+id/webdavHomeSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?textAppearanceListItemSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/webdavHomeOpen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/webdav_home_open" />

        <Button
            android:id="@+id/webdavHomeSyncAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/webdav_home_sync_all" />
    </LinearLayout>
</LinearLayout>
